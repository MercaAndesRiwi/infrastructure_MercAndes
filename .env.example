APP_ENV=development

POS_DB_HOST=postgres
POS_DB_PORT=5432
POS_DB_NAME=change_me
POS_DB_USER=change_me
POS_DB_PASSWORD=change_me

RABBITMQ_USER=guest_user
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=9000

SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_MEMORY=1G
SPARK_WORKER_CORES=1

AIRFLOW_IMAGE_NAME=apache/airflow:3.1.5
AIRFLOW_PORT=8080
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=change_me
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change_me

POS_API_PORT=8001
INVENTORY_API_PORT=8002
MARKETPLACE_API_PORT=8003

POS_SEED=42
POS_MODE=dev
MASTER_SEED=42
CATALOG_PER_CATEGORY=15
F4_DUPLICATE_RATE=0.0
F4_OOO_ENABLED=false 
# Kafka / Speed Layer
KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=9000
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9092
KAFKA_TOPIC_ORDERS=mercaandes.orders.events
KAFKA_ORDERS_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_RETENTION_HOURS=168
SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_MEMORY=1G
SPARK_WORKER_CORES=1
