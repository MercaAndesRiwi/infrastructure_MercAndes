APP_ENV=development

# Domain Postgres (seeds live in the sibling data-processing repo)
POS_DB_HOST=postgres
POS_DB_PORT=5432
POS_DB_NAME=change_me
POS_DB_USER=change_me
POS_DB_PASSWORD=change_me

# Credentials for RabbitMQ (seeds live in the sibling data-processing repo)

RABBITMQ_USER=guest_user
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

KAFKA_HOST_PORT=9092

SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_MEMORY=1G
SPARK_WORKER_CORES=1