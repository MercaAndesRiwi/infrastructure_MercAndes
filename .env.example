

# -----------------------------------------------------------------------------
# APP ENVIRONMENT
# -----------------------------------------------------------------------------
APP_ENV=development

# -----------------------------------------------------------------------------
# POSTGRESQL DATABASE (POS transactional database - Merca Pos)
# -----------------------------------------------------------------------------
# These are used by all services that connect to the shared PostgreSQL database.
# REQUIRED: Change the password and database name to your own values.
POS_DB_HOST=postgres
POS_DB_PORT=5432
POS_DB_NAME=merca_pos
POS_DB_USER=pos_user
POS_DB_PASSWORD=change_me_to_a_secure_password

# -----------------------------------------------------------------------------
# RABBITMQ (Message broker for alerts and event queues)
# -----------------------------------------------------------------------------
RABBITMQ_USER=guest_user
RABBITMQ_PASSWORD=change_me_to_a_secure_password
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# -----------------------------------------------------------------------------
# KAFKA (Event streaming platform)
# -----------------------------------------------------------------------------
KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=9000

# -----------------------------------------------------------------------------
# SPARK (Batch processing engine)
# -----------------------------------------------------------------------------
SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_MEMORY=1G
SPARK_WORKER_CORES=1

# -----------------------------------------------------------------------------
# AIRFLOW (Workflow orchestration)
# -----------------------------------------------------------------------------
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.5
AIRFLOW_PORT=8080
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_to_a_secure_password
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change_me_to_a_secure_password
AIRFLOW_FLOWER_PORT=5555

# -----------------------------------------------------------------------------
# API SERVICE PORTS (Internal Docker network ports)
# -----------------------------------------------------------------------------
POS_API_PORT=8001
INVENTORY_API_PORT=8002
MARKETPLACE_API_PORT=8003
F7_WEEKLY_PROMOTIONS_API_PORT=8004

# -----------------------------------------------------------------------------
# SEED CONFIGURATION (Data generation parameters)
# -----------------------------------------------------------------------------
POS_SEED=42
POS_MODE=dev
MASTER_SEED=42
CATALOG_PER_CATEGORY=15
F4_DUPLICATE_RATE=0.0
F4_OOO_ENABLED=false

# -----------------------------------------------------------------------------
# F7: WEEKLY PROMOTIONS (Excel/CSV ingestion from commercial team)
# -----------------------------------------------------------------------------
# Path inside Docker containers where the F7 Excel/CSV file is mounted.
# Do NOT change this unless you change the docker-compose volume mount.
F7_WEEKLY_PROMOTIONS_LOCAL_INPUT_PATH=/opt/inputs/f7_promotions

# -----------------------------------------------------------------------------
# S3 / DATA LAKE (Amazon S3 or compatible object storage)
# -----------------------------------------------------------------------------
# REQUIRED: Replace with your own S3 bucket name and AWS credentials.
S3_DATA_LAKE_BUCKET_NAME=your-s3-bucket-name
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Carpetas dentro del bucket S3 (ajusta según tu estructura existente)
S3_BRONZE_FOLDER=bronze
S3_F1_KAGGLE_FOLDER=f1_kaggle
S3_F7_PROMOTIONS_FOLDER=f7_promotions

# -----------------------------------------------------------------------------
# EXISTING API URLS (F2-F6 sibling repositories within Docker network)
# -----------------------------------------------------------------------------
# These are internal Docker service names. Do NOT change unless you rename services.
POS_API_URL=http://pos-api:8001
INVENTORY_API_URL=http://inventory-api:8002
MARKETPLACE_API_URL=http://marketplace-api:8003
API_HOLIDAYS_URL=http://api-holidays:8000
API_EXCHANGE_RATES_URL=http://api-exchange-rates:8000

# -----------------------------------------------------------------------------
# KAFKA TOPICS (Event topics used by producers and consumers)
# -----------------------------------------------------------------------------
KAFKA_TOPIC_ORDERS=mercaandes.orders.events
KAFKA_TOPIC_PROMOTIONS_WEEKLY=mercaandes.promotions.weekly

# -----------------------------------------------------------------------------
# RABBITMQ QUEUES (Alert and ingestion queues)
# -----------------------------------------------------------------------------
RABBITMQ_QUEUE_STOCKOUT_ALERTS=mercaandes.alerts.stockout
RABBITMQ_QUEUE_SILENT_STORE=mercaandes.alerts.silent-store
RABBITMQ_QUEUE_PROMOTIONS_WEEKLY_INGEST=mercaandes.promotions.weekly.ingest
RABBITMQ_QUEUE_PURCHASE_NOTIFICATIONS=mercaandes.notifications.purchase

# -----------------------------------------------------------------------------
# SMTP / EMAIL NOTIFICATIONS (AWS SES or external SMTP, Port 587 STARTTLS)
# -----------------------------------------------------------------------------
# Para AWS SES en us-east-1 usar: email-smtp.us-east-1.amazonaws.com
# O dejar vacío para modo Simulación / Dry-Run en logs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER= tu_correo_personal@gmail.com
SMTP_PASSWORD= 
SMTP_USE_TLS=true
EMAIL_FROM=atencion@mercaandes.com


# ¿Cómo obtienes esa contraseña de Gmail (SMTP_PASSWORD)?
# No es tu contraseña habitual de Google. Se genera en 30 segundos así:

# 1. Ve a tu cuenta de Google
# 2. Entra en Seguridad y asegúrate de tener activada la Verificación en 2 pasos.
# 3.  En el buscador de la cuenta escribe "Contraseñas de aplicaciones" (App Passwords).
# 4. Ponle un nombre (ej. MercaAndes) y Google te dará una clave de 16 letras (ej. abcd efgh ijkl mnop). Esa es la que pegas en SMTP_PASSWORD.

# -----------------------------------------------------------------------------
# KAFKA / SPEED LAYER CONFIGURATION
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9092
KAFKA_TOPIC_ORDERS=mercaandes.orders.events
KAFKA_ORDERS_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_RETENTION_HOURS=168
